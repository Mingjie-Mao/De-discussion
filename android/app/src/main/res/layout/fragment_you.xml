<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:paddingStart="14dp"
            android:paddingTop="20dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textYouAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="false"
                    android:foreground="@null"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="C"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textYouNickname"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:clickable="true"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:foreground="@null"
                            android:maxLines="1"
                            android:stateListAnimator="@null"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="@color/ink_primary"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textYouUid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/ink_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutYouFollowing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="false"
                    android:foreground="@null"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:stateListAnimator="@null">

                    <TextView
                        android:id="@+id/textYouFollowingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/ink_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/you_following"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/ink_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutYouFollowers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="false"
                    android:foreground="@null"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:stateListAnimator="@null">

                    <TextView
                        android:id="@+id/textYouFollowersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/ink_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/you_followers"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/ink_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutYouEngagement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="false"
                    android:foreground="@null"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:stateListAnimator="@null">

                    <TextView
                        android:id="@+id/textYouEngagementCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/ink_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/you_engagement"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/ink_secondary" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonYouSettings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_pill"
                android:contentDescription="@string/settings_title"
                android:padding="8dp"
                android:src="@drawable/ic_settings_24"
                app:tint="@color/ink_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <Button
                android:id="@+id/buttonYouTabPosts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/you_tab_posts"
                android:textAllCaps="false"
                android:textColor="@color/ink_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/tab_bar_fill"
                app:cornerRadius="999dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/buttonYouTabComments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/you_tab_comments"
                android:textAllCaps="false"
                android:textColor="@color/ink_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/tab_bar_fill"
                app:cornerRadius="999dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/buttonYouTabSaved"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/you_tab_saved"
                android:textAllCaps="false"
                android:textColor="@color/ink_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/tab_bar_fill"
                app:cornerRadius="999dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/buttonYouTabLiked"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/you_tab_liked"
                android:textAllCaps="false"
                android:textColor="@color/ink_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/tab_bar_fill"
                app:cornerRadius="999dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textYouPostsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/you_posts_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/ink_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerYouPosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <LinearLayout
            android:id="@+id/layoutYouComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProfileMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feed_load_more"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
